<div id="adminLoggedOut"><button class="btn" onclick="adminLogin()">Google দিয়ে লগইন</button></div>
<div id="adminArea" class="hidden">
<div class="row"><strong id="adminIdentity"></strong><button class="ghost" onclick="adminLogout()">লগআউট</button><button class="btn secondary" onclick="loadOrders()">অর্ডার রিফ্রেশ</button></div>
