<input type="hidden" id="editProductId">
<label>পণ্যের নাম</label><input id="pName" placeholder="পণ্যের নাম">
<div class="grid"><div><label>দাম (৳)</label><input id="pPrice" type="number" min="0" placeholder="500"></div><div><label>ক্যাটাগরি</label><input id="pCategory" placeholder="General"></div></div>
