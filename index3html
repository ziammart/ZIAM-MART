<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#090909">
<title>ZIAM MART — Premium Online Shopping</title>
<style>
:root{--bg:#090909;--panel:#151515;--panel2:#1c1c1c;--gold:#d8b45b;--gold2:#f0d58b;--text:#f7f3e9;--muted:#aaa49a;--line:#39342a;--danger:#ff7777;--ok:#75d49a}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Noto Sans Bengali",sans-serif}
button,input,select,textarea{font:inherit}button{cursor:pointer}
header{position:sticky;top:0;z-index:5;background:#080808ed;border-bottom:1px solid #514326;backdrop-filter:blur(12px)}
.top{max-width:1100px;margin:auto;padding:13px 16px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.brand{font-size:21px;letter-spacing:2px;font-weight:900;color:var(--gold);text-decoration:none}.brand small{display:block;font-size:9px;letter-spacing:1.6px;color:#aaa;font-weight:500}
nav{display:flex;gap:8px;flex-wrap:wrap}nav button,.ghost{background:transparent;color:var(--text);border:1px solid var(--line);border-radius:9px;padding:9px 12px}
.hero{max-width:1100px;margin:18px auto;padding:0 16px}.heroBox{border:1px solid #69552c;border-radius:16px;padding:36px 20px;text-align:center;background:radial-gradient(ellipse at top,#302515,#111 68%);box-shadow:0 12px 40px #0008}
.hero h1{color:var(--gold2);font-size:clamp(27px,6vw,44px);margin:0 0 8px}.hero p{color:#c5bda9;margin:0 auto 17px;max-width:550px}
.btn{border:0;border-radius:9px;padding:11px 16px;background:linear-gradient(135deg,#f0d58b,#bd923a);color:#16110a;font-weight:800}
.btn.secondary{background:#29251d;color:var(--gold2);border:1px solid #65532e}.btn.danger{background:#512626;color:#fff}
main{max-width:1100px;margin:0 auto;padding:0 16px 50px}.section{background:var(--panel);border:1px solid #302d27;border-radius:15px;padding:18px;margin:16px 0;box-shadow:0 8px 25px #0004}
h2{font-size:22px;margin:0 0 15px;color:var(--gold2)}h3{font-size:17px;margin:0 0 9px}
.muted{color:var(--muted)}.tiny{font-size:12px;color:var(--muted)}
input,select,textarea{width:100%;background:#0d0d0d;border:1px solid #514b40;border-radius:9px;padding:12px;color:var(--text);outline:none}
input:focus,select:focus,textarea:focus{border-color:var(--gold)}label{display:block;font-size:14px;margin:10px 0 6px;color:#e8dfcc}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:13px}.products{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:13px}
.product{border:1px solid #40392c;border-radius:12px;overflow:hidden;background:#101010}.product img{width:100%;height:145px;object-fit:cover;background:#272727}.product .pad{padding:12px}.price{color:var(--gold2);font-weight:900}.product button{width:100%;margin-top:8px}
.row{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.row>*{flex:1}.pill{font-size:11px;border:1px solid #68552e;color:var(--gold2);border-radius:20px;padding:4px 9px}
.cartline{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid #302d27}.cartline:last-child{border:0}
.total{font-size:20px;color:var(--gold2);font-weight:900}.notice{padding:11px;border-radius:9px;background:#282113;border:1px solid #65532e;color:#e9d59e;font-size:13px;margin:10px 0}
.hidden{display:none!important}.adminOrder{border:1px solid #39342a;border-radius:10px;padding:12px;margin:10px 0;background:#101010}
footer{text-align:center;color:#8e877b;padding:25px;border-top:1px solid #2d2922;font-size:13px}
#toast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:#262116;color:#f7e6b5;padding:12px 16px;border:1px solid #806a39;border-radius:10px;z-index:20;max-width:90%;display:none}

/* WhatsApp Floating Button Style */
.wa-float{position:fixed;bottom:20px;right:20px;background-color:#25d366;color:#fff;width:55px;height:55px;border-radius:50px;text-align:center;box-shadow:2px 2px 12px rgba(0,0,0,0.5);z-index:100;display:flex;align-items:center;justify-content:center;text-decoration:none;transition:transform 0.3s ease}
.wa-float:hover{transform:scale(1.1)}
.wa-float svg{width:32px;height:32px;fill:#fff}

@media(max-width:600px){.top{align-items:flex-start}.brand{font-size:18px}nav button{padding:7px 9px;font-size:12px}.section{padding:14px}.heroBox{padding:28px 14px}.wa-float{bottom:15px;right:15px;width:50px;height:50px}.wa-float svg{width:28px;height:28px}}
</style>
</head>
