<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
// ===================== ZIAM MART CONFIG =====================
const CONFIG = {
  SUPABASE_URL: "PASTE_SUPABASE_PROJECT_URL_HERE",
  SUPABASE_ANON_KEY: "PASTE_SUPABASE_ANON_OR_PUBLISHABLE_KEY_HERE",
  ADMIN_EMAILS: ["YOUR_ADMIN_GMAIL@gmail.com"],
  WHATSAPP_NUMBER: "8801822412757", // 880 সহ, + চিহ্ন ছাড়া
  BKASH_NUMBER: "01776131624",
  DELIVERY_INSIDE_LAKSHMIPUR: 70,  // লক্ষ্মীপুর জেলার ভেতরে
  DELIVERY_OUTSIDE_LAKSHMIPUR: 120 // লক্ষ্মীপুর জেলার বাইরে
};
// ============================================================
const GEO_URL="https://iqbalhasandev.github.io/bangladesh-geo-json/bangladesh-geo.json";
let supabase=null, geo=[], products=[], cart=[], session=null;
let currentDeliveryFee = CONFIG.DELIVERY_OUTSIDE_LAKSHMIPUR;
let currentDeliveryZoneText = "লক্ষ্মীপুরের বাইরে";

const money=n=>"৳"+Number(n||0).toLocaleString("en-US");
const $=id=>document.getElementById(id);
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
function toast(s){const t=$("toast");t.textContent=s;t.style.display="block";setTimeout(()=>t.style.display="none",3200)}
function scrollToId(id){$(id).scrollIntoView({behavior:"smooth"})}

function fee(){return currentDeliveryFee;}
function subtotal(){return cart.reduce((s,x)=>s+x.price*x.qty,0)}
function updateFees(){
  $("deliveryZoneInfo").textContent = `${currentDeliveryZoneText} (${money(fee())})`;
  $("grandTotal").textContent = money(subtotal() + fee());
}
function renderCart(){
 const box=$("cartItems");$("cartCount").textContent=cart.reduce((s,x)=>s+x.qty,0);
 if(!cart.length)box.innerHTML='<p class="muted">কার্ট খালি। পণ্য যোগ করুন।</p>';
 else box.innerHTML=cart.map((x,i)=>`<div class="cartline"><div><b>${esc(x.name)}</b><div class="tiny">${money(x.price)} × ${x.qty}</div></div><div class="row" style="flex:0 0 auto"><button class="ghost" onclick="qty(${i},-1)">−</button><b>${x.qty}</b><button class="ghost" onclick="qty(${i},1)">+</button><button class="ghost" onclick="removeCart(${i})">×</button></div></div>`).join("");
 $("subtotal").textContent=money(subtotal());updateFees()
}
function qty(i,n){cart[i].qty+=n;if(cart[i].qty<1)cart.splice(i,1);renderCart()}
function removeCart(i){cart.splice(i,1);renderCart()}
function addCart(p){let x=cart.find(x=>x.id===p.id);if(x)x.qty++;else cart.push({...p,qty:1});renderCart();toast("কার্টে পণ্য যোগ হয়েছে")}
function renderProducts(){
 const q=$("search").value.toLowerCase(),cat=$("categoryFilter").value;
 const list=products.filter(p=>(!cat||p.category===cat)&&(!q||(p.name+" "+(p.description||"")).toLowerCase().includes(q)));
 $("productList").innerHTML=list.length?list.map(p=>`<article class="product"><img src="${esc(p.image_url||"https://placehold.co/600x400/222/dfc477?text=ZIAM+MART")}" alt="${esc(p.name)}" onerror="this.src='https://placehold.co/600x400/222/dfc477?text=ZIAM+MART'"><div class="pad"><b>${esc(p.name)}</b><p class="tiny">${esc(p.description||"")}</p><div class="price">${money(p.price)}</div><button class="btn" onclick='addCart(${JSON.stringify({id:p.id,name:p.name,price:Number(p.price),image_url:p.image_url||"",category:p.category||""}).replace(/'/g,"&#39;")})'>কার্টে যোগ করুন</button><button class="btn secondary" onclick='addCart(${JSON.stringify({id:p.id,name:p.name,price:Number(p.price),image_url:p.image_url||"",category:p.category||""}).replace(/'/g,"&#39;")});scrollToId("checkout")'>এখনই কিনুন</button></div></article>`).join(""):'<p class="muted">এখনো কোনো পণ্য যোগ করা হয়নি। অ্যাডমিন প্যানেল থেকে পণ্য যোগ করুন।</p>';
}
function updateCategories(){let cats=[...new Set(products.map(p=>p.category).filter(Boolean))];$("categoryFilter").innerHTML='<option value="">সব ক্যাটাগরি</option>'+cats.map(c=>`<option>${esc(c)}</option>`).join("")}
async function loadProducts(){
 if(supabase){const {data,error}=await supabase.from("products").select("*").eq("active",true).order("created_at",{ascending:false});if(!error&&data)products=data}
 if(!products.length)products=[{id:"demo1",name:"Sample Product One",price:500,category:"General",description:"ডেমো পণ্য — অ্যাডমিন থেকে নিজের পণ্য যোগ করুন।",image_url:""}];
 updateCategories();renderProducts()
}

// Location dataset
async function loadGeo(){
 try{const r=await fetch(GEO_URL);if(!r.ok)throw Error("location data");geo=await r.json();$("division").innerHTML='<option value="">বিভাগ নির্বাচন করুন</option>'+geo.map((d,i)=>`<option value="${i}">${esc(d.bn_name||d.name)}</option>`).join("")}
 catch(e){$("division").innerHTML='<option value="">লোকেশন তালিকা লোড হয়নি — পরে আবার চেষ্টা করুন</option>';toast("এলাকার তালিকা আনতে ইন্টারনেট সংযোগ পরীক্ষা করুন")}
}
function onDivision(){
  let d=geo[+$("division").value];
  $("district").innerHTML='<option value="">জেলা নির্বাচন করুন</option>'+(d?.districts||[]).map((x,i)=>`<option value="${i}">${esc(x.bn_name||x.name)}</option>`).join("");
  $("district").disabled=!d;
  $("upazila").innerHTML='<option value="">উপজেলা নির্বাচন করুন</option>';$("upazila").disabled=true;
  $("union").innerHTML='<option value="">ইউনিয়ন / পৌরসভা নির্বাচন করুন</option>';$("union").disabled=true;
  
  currentDeliveryFee = CONFIG.DELIVERY_OUTSIDE_LAKSHMIPUR;
  currentDeliveryZoneText = "লক্ষ্মীপুরের বাইরে";
  updateFees();
}
function onDistrict(){
  let d=geo[+$("division").value]?.districts?.[+$("district").value];
  $("upazila").innerHTML='<option value="">উপজেলা নির্বাচন করুন</option>'+(d?.upazilas||[]).map((x,i)=>`<option value="${i}">${esc(x.bn_name||x.name)}</option>`).join("");
  $("upazila").disabled=!d;
  $("union").innerHTML='<option value="">ইউনিয়ন / পৌরসভা নির্বাচন করুন</option>';$("union").disabled=true;
  
  if (d) {
    const districtName = (d.bn_name || d.name || "").trim();
    if (districtName.includes("লক্ষ্মীপুর") || districtName.toLowerCase().includes("lakshmipur")) {
      currentDeliveryFee = CONFIG.DELIVERY_INSIDE_LAKSHMIPUR;
      currentDeliveryZoneText = "লক্ষ্মীপুরের ভেতরে";
    } else {
      currentDeliveryFee = CONFIG.DELIVERY_OUTSIDE_LAKSHMIPUR;
      currentDeliveryZoneText = "লক্ষ্মীপুরের বাইরে";
    }
  } else {
    currentDeliveryFee = CONFIG.DELIVERY_OUTSIDE_LAKSHMIPUR;
    currentDeliveryZoneText = "লক্ষ্মীপুরের বাইরে";
  }
  updateFees();
}
function onUpazila(){let u=geo[+$("division").value]?.districts?.[+$("district").value]?.upazilas?.[+$("upazila").value];let arr=[...(u?.unions||[]).map(x=>({...x,type:"ইউনিয়ন"})),...(u?.pourashavas||[]).map(x=>({...x,type:"পৌরসভা"}))];$("union").innerHTML='<option value="">ইউনিয়ন / পৌরসভা নির্বাচন করুন</option>'+arr.map(x=>`<option>${esc((x.bn_name||x.name)+" ("+x.type+")")}</option>`).join("");$("union").disabled=!arr.length}
function selectedLocation(){let d=geo[+$("division").value],z=d?.districts?.[+$("district").value],u=z?.upazilas?.[+$("upazila").value];return {division:d?.bn_name||d?.name||"",district:z?.bn_name||z?.name||"",upazila:u?.bn_name||u?.name||"",union:$("union").value}}
function addressData(){return {name:$("customerName").value.trim(),phone:$("customerPhone").value.trim(),zone:currentDeliveryZoneText,...selectedLocation(),village:$("village").value.trim(),road:$("road").value.trim(),address:$("address").value.trim()}}
async function placeOrder(){
 if(!cart.length)return toast("প্রথমে কার্টে পণ্য যোগ করুন");
 const a=addressData(),sender=$("bkashSender").value.trim(),trx=$("trxId").value.trim();
 if(!a.name||!/^01[3-9]\d{8}$/.test(a.phone)||!a.division||!a.district||!a.upazila||!a.village||!a.address)return toast("সব আবশ্যক তথ্য সঠিকভাবে পূরণ করুন");
 if(!sender||!trx)return toast("bKash নম্বর ও Transaction ID দিন");
 if(fee()<=0)return toast("প্রশাসককে আগে ডেলিভারি চার্জ সেট করতে হবে।");
 const order={customer_name:a.name,customer_phone:a.phone,delivery_zone:a.zone,division:a.division,district:a.district,upazila:a.upazila,union_name:a.union,village:a.village,road:a.road,full_address:a.address,items:cart.map(x=>({id:x.id,name:x.name,price:x.price,qty:x.qty})),subtotal:subtotal(),delivery_fee:fee(),total:subtotal()+fee(),advance_due:fee(),product_due:subtotal(),payment_method:document.querySelector('input[name="payment"]:checked').value,bkash_sender:sender,bkash_trxid:trx,note:$("note").value.trim(),status:"নতুন",created_at:new Date().toISOString()};
 let saved=false;
 if(supabase){const {error}=await supabase.from("orders").insert(order);if(!error)saved=true;else console.error(error)}
 const lines=order.items.map(x=>`• ${x.name} × ${x.qty} — ${money(x.price*x.qty)}`).join("\n");
 const msg=`ZIAM MART — নতুন অর্ডার\nনাম: ${a.name}\nমোবাইল: ${a.phone}\nএলাকা: ${a.zone}\nঠিকানা: ${a.division}, ${a.district}, ${a.upazila}, ${a.union}, ${a.village}, ${a.road}, ${a.address}\n\nপণ্য:\n${lines}\n\nপণ্যের মূল্য: ${money(order.subtotal)}\nঅগ্রিম ডেলিভারি চার্জ: ${money(order.delivery_fee)}\nসর্বমোট: ${money(order.total)}\nকুরিয়ারে পণ্যের মূল্য: ${money(order.product_due)}\nbKash প্রেরক: ${sender}\nTrxID: ${trx}\nনোট: ${order.note}\nSupabase-এ সংরক্ষিত: ${saved?"হ্যাঁ":"না — WhatsApp-এ এসেছে"}`;
 const wa=CONFIG.WHATSAPP_NUMBER.replace(/\D/g,"");
 if(!wa||wa.includes("XXXXXXXX"))return toast("কোডে আপনার WhatsApp নম্বর বসান");
 window.open("https://wa.me/"+wa+"?text="+encodeURIComponent(msg),"_blank");
 if(saved)toast("অর্ডার Supabase-এ সংরক্ষিত হয়েছে। WhatsApp-এ পাঠানোও খুলেছে।");else toast("WhatsApp অর্ডার খুলেছে। Supabase সেটআপ না থাকায় অ্যাডমিন তালিকায় সংরক্ষিত হয়নি।");
}
function configured(){return supabase!==null}
async function adminLogin(){if(!configured())return toast("আগে Supabase URL ও key বসান");const {error}=await supabase.auth.signInWithOAuth({provider:"google",options:{redirectTo:location.href}});if(error)toast(error.message)}
async function adminLogout(){await supabase.auth.signOut();session=null;showAdmin()}
function showAdmin(){
 const email=session?.user?.email||"",allowed=CONFIG.ADMIN_EMAILS.map(x=>x.toLowerCase()).includes(email.toLowerCase());
 $("adminLoggedOut").classList.toggle("hidden",!!session);$("adminArea").classList.toggle("hidden",!(session&&allowed));
 $("setupWarning").classList.toggle("hidden",!!(session&&allowed));
 if(session&&!allowed)toast("এই Google অ্যাকাউন্টটি Admin হিসেবে অনুমোদিত নয়");
 if(session&&allowed){$("adminIdentity").textContent=email;loadOrders();loadAdminProducts()}
}
async function saveProduct(){
 if(!session)return toast("প্রথমে Admin লগইন করুন");
 const id=$("editProductId").value,p={name:$("pName").value.trim(),price:Number($("pPrice").value),category:$("pCategory").value.trim()||"General",image_url:$("pImage").value.trim(),description:$("pDescription").value.trim(),active:true};
 if(!p.name||!Number.isFinite(p.price)||p.price<0)return toast("পণ্যের নাম ও সঠিক দাম দিন");
 let q=id?supabase.from("products").update(p).eq("id",id):supabase.from("products").insert(p);
 const {error}=await q;if(error)return toast("পণ্য সংরক্ষণ হয়নি: "+error.message);
 clearProductForm();await loadProducts();loadAdminProducts();toast("পণ্য সংরক্ষণ হয়েছে")
}
function clearProductForm(){["editProductId","pName","pPrice","pCategory","pImage","pDescription"].forEach(x=>$(x).value="")}
async function loadAdminProducts(){
 const {data,error}=await supabase.from("products").select("*").order("created_at",{ascending:false});
 if(error){$("adminProducts").textContent=error.message;return}
 $("adminProducts").innerHTML=(data||[]).map(p=>`<div class="cartline"><div><b>${esc(p.name)}</b><div class="tiny">${money(p.price)} · ${esc(p.category||"")}</div></div><div class="row" style="flex:0 0 auto"><button class="ghost" onclick='editProduct(${JSON.stringify(p).replace(/'/g,"&#39;")})'>Edit</button><button class="ghost" onclick="deleteProduct('${p.id}')">Delete</button></div></div>`).join("")||"এখনো পণ্য নেই।"
}
function editProduct(p){$("editProductId").value=p.id;$("pName").value=p.name;$("pPrice").value=p.price;$("pCategory").value=p.category||"";$("pImage").value=p.image_url||"";$("pDescription").value=p.description||"";scrollToId("admin")}
async function deleteProduct(id){if(!confirm("এই পণ্যটি মুছে ফেলবেন?"))return;const {error}=await supabase.from("products").delete().eq("id",id);if(error)return toast(error.message);await loadProducts();loadAdminProducts()}
async function loadOrders(){
 const {data,error}=await supabase.from("orders").select("*").order("created_at",{ascending:false}).limit(100);
 if(error){$("ordersList").textContent="অর্ডার পড়া যায়নি: "+error.message;return}
 $("ordersList").innerHTML=(data||[]).map(o=>`<div class="adminOrder"><div class="row"><b>${esc(o.customer_name)} — ${money(o.total)}</b><span class="pill">${esc(o.status||"নতুন")}</span></div><p class="tiny">${esc(o.customer_phone)} · ${esc(o.division||"")}, ${esc(o.district||"")}, ${esc(o.upazila||"")}</p><p class="tiny">${esc(o.full_address||"")}</p><p class="tiny">ডেলিভারি অগ্রিম: ${money(o.delivery_fee)} · পণ্যের বাকি: ${money(o.product_due)} · TrxID: ${esc(o.bkash_trxid)}</p><pre class="tiny" style="white-space:pre-wrap">${esc(JSON.stringify(o.items||[],null,2))}</pre><select onchange="setOrderStatus('${o.id}',this.value)"><option ${o.status==="নতুন"?"selected":""}>নতুন</option><option ${o.status==="যাচাই হচ্ছে"?"selected":""}>যাচাই হচ্ছে</option><option ${o.status==="নিশ্চিত"?"selected":""}>নিশ্চিত</option><option ${o.status==="পাঠানো হয়েছে"?"selected":""}>পাঠানো হয়েছে</option><option ${o.status==="সম্পন্ন"?"selected":""}>সম্পন্ন</option><option ${o.status==="বাতিল"?"selected":""}>বাতিল</option></select></div>`).join("")||'<p class="muted">এখনো কোনো অর্ডার নেই।</p>'
}
async function setOrderStatus(id,status){const {error}=await supabase.from("orders").update({status}).eq("id",id);if(error)toast(error.message);else toast("অর্ডারের অবস্থা আপডেট হয়েছে")}
async function init(){
 $("year").textContent=new Date().getFullYear();$("bkashDisplay").textContent=CONFIG.BKASH_NUMBER;
 if(window.supabase?.createClient&&CONFIG.SUPABASE_URL.startsWith("https://")&&!CONFIG.SUPABASE_URL.includes("PASTE_")&&!CONFIG.SUPABASE_ANON_KEY.includes("PASTE_")){
  supabase=window.supabase.createClient(CONFIG.SUPABASE_URL,CONFIG.SUPABASE_ANON_KEY);
  const {data}=await supabase.auth.getSession();session=data.session;
  supabase.auth.onAuthStateChange((_event,s)=>{session=s;showAdmin()});
 }
 await Promise.all([loadGeo(),loadProducts()]);renderCart();showAdmin();
}
init();
</script>
</body>
